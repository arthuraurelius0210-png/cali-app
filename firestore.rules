rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /communityChallenges/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /globalLeaderboard/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }
    match /parkLeaderboard/{parkId}/entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }
    match /parkStats/{parkId}/users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /parkWorkouts/{parkId}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /personalBests/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /battles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.challengerId ||
         request.auth.uid == resource.data.challengedId);
      allow delete: if false;
    }
    match /parkKings/{parkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /parkSuggestions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /customParks/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /xp/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /xpLog/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if false;
    }
    match /exerciseSuggestions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read: if false;
    }
    match /challengeStats/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /trainingBuddies/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || resource.data.expiresAt < request.time);
    }
  }
}
