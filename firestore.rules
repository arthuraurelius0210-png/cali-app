rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Einziger Admin (Admin-Panel im Profil). Schreibrechte für Moderation hängen daran.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'u8PNuq4y2ahh2p7rukCa0vGD4su1';
    }
    // Like/Unlike: genau die eigene ID kommt in die Like-Liste oder geht raus,
    // dazu höchstens der eigene Zeitstempel in likedAt. Sonst ändert sich nichts.
    function isOwnLikeChange() {
      let before = resource.data.get('likes', []);
      let after = request.resource.data.get('likes', []);
      let uid = request.auth.uid;
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return keys.hasOnly(['likes', 'likedAt'])
        && after.toSet().size() == after.size()
        && ((after.size() == before.size() + 1 && added.size() == 1 && added.hasOnly([uid]) && removed.size() == 0)
          || (after.size() == before.size() - 1 && removed.size() == 1 && removed.hasOnly([uid]) && added.size() == 0))
        && (!('likedAt' in keys)
          || request.resource.data.get('likedAt', {}).diff(resource.data.get('likedAt', {})).affectedKeys().hasOnly([uid]));
    }
    // Kommentar: genau ein neuer Kommentar hinten dran, mit der eigenen ID, alte bleiben unverändert.
    function isOwnCommentAdd() {
      let before = resource.data.get('comments', []);
      let after = request.resource.data.get('comments', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && after.size() == before.size() + 1
        && after[0:before.size()] == before
        && after[before.size()].uid == request.auth.uid;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Freunde: öffentliches Profil (Name, kleines Bild, Level, Streak, Einladungscode).
    // Jeder Eingeloggte liest, nur der Besitzer schreibt. Das users-Dokument bleibt privat.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Einladungscode → UID. Nur der Besitzer legt seinen an, jeder Eingeloggte darf ihn auflösen.
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Freundschaft: eine Datei je Paar, ID = kleinere_größere UID, members = [a, b] sortiert.
    // Anfrage (pending) legt der Absender an, angenommen wird nur vom Empfänger. Mit gültigem
    // Einladungscode des anderen darf sie sofort als accepted angelegt werden. Löschen darf jedes Mitglied.
    function fsData() { return request.resource.data; }
    function fsValidPair(id) {
      return fsData().members is list && fsData().members.size() == 2
        && fsData().members[0] is string && fsData().members[1] is string
        && fsData().members[0] < fsData().members[1]
        && id == fsData().members[0] + '_' + fsData().members[1]
        && request.auth.uid in fsData().members
        && fsData().requestedBy == request.auth.uid;
    }
    function fsInviteOk() {
      let inv = get(/databases/$(database)/documents/invites/$(fsData().inviteCode)).data;
      return inv.uid in fsData().members && inv.uid != request.auth.uid;
    }
    match /friendships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && fsValidPair(pairId)
        && (fsData().status == 'pending'
            || (fsData().status == 'accepted' && 'inviteCode' in fsData() && fsInviteOk()));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && fsData().status == 'accepted'
        && fsData().diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    match /communityChallenges/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('likes', []).size() == 0
        && request.resource.data.get('comments', []).size() == 0;
      allow update: if request.auth != null && (isOwnLikeChange() || isOwnCommentAdd());
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // Challenge der Woche: fertige Katalog-Einträge je Kalenderwoche, nur der Admin schreibt.
    match /featuredChallenges/{weekId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /globalLeaderboard/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      allow delete: if false;
    }
    match /parkLeaderboard/{parkId}/entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }
    match /parkStats/{parkId}/users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /parkWorkouts/{parkId}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /personalBests/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /battles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.challengerId ||
         request.auth.uid == resource.data.challengedId);
      allow delete: if false;
    }
    match /parkKings/{parkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /parkSuggestions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /customParks/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // XP und Diamanten schreibt nur noch der Server (Cloud Functions earn/spend), der Admin
    // für die Monatsboni. Der Nutzer liest sein XP-Dokument, alle lesen für die Rangliste.
    match /xp/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /xpLog/{docId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    // Geldbörse: nur lesen, und nur die eigene. Jede Änderung läuft über Cloud Functions.
    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    // Abnahmen: der Antragsteller sieht seine, der Admin alle. Anlegen und Entscheiden nur per Function.
    match /verifications/{docId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // Verifizierte Abzeichen sind öffentlich (Profil), schreibt nur die Function.
    match /verifiedBadges/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /walletLog/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /exerciseSuggestions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read: if false;
    }
    match /challengeStats/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /trainingBuddies/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || resource.data.expiresAt < request.time);
    }
  }
}
